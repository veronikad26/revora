# --- LLM ---
GEMINI_API_KEY=

# --- Payments ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Messaging ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_URL=

# --- Database ---
DATABASE_URL=sqlite:///./revora.db

# --- LangGraph case-state checkpoints (separate from DATABASE_URL above) ---
# Without this, case state (root_cause_category, ptp_state, authorized_action,
# audit_trail, etc.) lives only in memory and is lost on every server restart,
# even though FailureEvent/CheckoutEvent/etc. rows survive fine. See
# app/config.py for the full explanation.
LANGGRAPH_CHECKPOINT_PATH=./revora_checkpoints.db

# --- App ---
APP_ENV=development
DRY_RUN=true
HTTP_TIMEOUT_SECONDS=15
# Dashboard timeout must cover synchronous checkout/receivable graph processing.
REVORA_API_CLIENT_TIMEOUT_SECONDS=60
GEMINI_MODEL=gemini-1.5-flash
